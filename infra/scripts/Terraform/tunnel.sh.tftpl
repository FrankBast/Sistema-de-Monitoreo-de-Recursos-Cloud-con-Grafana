#!/bin/bash
# ==============================================================================
# 4. TUNNEL (Cloudflare + Node Exporter)
# ==============================================================================
cat <<'EOF' > tunnel.sh.tftpl
exec > >(tee /var/log/user-data.log|logger -t user-data -s) 2>&1
echo ">>> CONFIGURANDO TUNNEL + MONITOREO <<<"

# Instalacion Base
sudo apt update -y
sudo apt install -y ca-certificates curl gnupg lsb-release
sudo mkdir -p /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo gpg --dearmor -o /etc/apt/keyrings/docker.gpg
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
sudo apt update
sudo apt install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
sudo mkdir -p /opt/ansd/app
#sudo ip route add 192.168.1.0/24 via 100.16.0.2 dev CloudflareWARP

# Docker Compose
# NOTA: Terraform reemplazará ${tunnel_token} automáticamente
cat <<EOC > /opt/ansd/app/docker-compose.yml
services:
  # Servicio Principal
  tunnel:
    image: cloudflare/cloudflared:latest
    container_name: ansd-tunnel
    restart: always
    command: tunnel run
    environment:
      - TUNNEL_TOKEN=${tunnel_token}

  # Agente de Monitoreo
  node_exporter:
    image: prom/node-exporter:latest
    container_name: monitoring
    restart: always
    ports: ["9100:9100"]
EOC

# Permisos y Arranque
sudo chown -R ubuntu:ubuntu /opt/ansd
cd /opt/ansd/app && docker compose up -d
EOF